{
  "version": 1,
  "min_core": "0.1.0",
  "log": {
    "level": "debug",
    "outputs": [{ "type": "stderr", "format": "human", "color": true }]
  },

  "inbounds": [
    {
      "tag": "socks-in",
      "listen": "127.0.0.1",
      "port": 1080,
      "network": "tcp",
      "handshake_timeout": "10s",
      "transport": [{ "type": "tcp" }],
      "protocol": { "type": "socks5", "settings": { "udp_relay": true } }
    },
    {
      "tag": "http-in",
      "listen": "127.0.0.1",
      "port": 1081,
      "network": "tcp",
      "transport": [{ "type": "tcp" }],
      "protocol": { "type": "http" }
    },
    {
      "tag": "mixed-in",
      "listen": "127.0.0.1",
      "port": 1082,
      "network": "tcp",
      "transport": [{ "type": "tcp" }],
      "protocol": {
        "type": "mixed",
        "settings": {
          "socks5": { "udp_relay": true },
          "http": {}
        }
      }
    }
  ],

  "outbounds": [
    {
      "tag": "freedom",
      "protocol": { "type": "freedom" }
    },
    {
      "tag": "freedom-fragment",
      "transport": [
        { "type": "tcp" },
        {
          "type": "fragment",
          "settings": {
            "tls_records": true,
            "tcp_packets": true,
            "piece_sizes": ["3-5", "10-20"],
            "piece_delays": ["10-20ms"],
            "max_pieces": "4-8",
            "split_sni": true
          }
        }
      ],
      "protocol": { "type": "freedom" }
    },
    {
      "tag": "block",
      "protocol": { "type": "block" }
    }
  ]
}
