{
  "version": 1,
  "min_core": "0.1.0",
  "log": {
    "level": "debug",
    "outputs": [{ "type": "stderr", "format": "human", "color": true }]
  },

  "dns": {
    "ip_versions": "prefer_ipv4",
    "servers": [
      {
        "tag": "cloudflare-dot",
        "type": "dot",
        "settings": { "server": "1.1.1.1" },
        "tls": { "server_name": "one.one.one.one" },
        "outbound": "freedom-fragment"
      },
      {
        "tag": "google-doh",
        "type": "doh",
        "settings": { "server": "dns.google", "path": "/dns-query" },
        "outbound": "freedom-fragment"
      },
      {
        "tag": "google-tcp",
        "type": "tcp",
        "settings": { "server": "8.8.8.8" }
      },
      {
        "tag": "cloudflare-udp",
        "type": "udp",
        "settings": { "server": "1.1.1.1", "timeout": "3s" }
      },
      { "tag": "os", "type": "system" }
    ],
    "rules": [
      { "match": { "domain_suffix": ["ir"] }, "server": "os" },
      { "match": { "domain_suffix": ["google.com", "gstatic.com"] }, "server": "google-doh" }
    ],
    "default_server": "cloudflare-dot"
  },

  "inbounds": [
    {
      "tag": "socks-in",
      "listen": "127.0.0.1",
      "port": 1080,
      "network": "tcp",
      "transport": [{ "type": "tcp" }],
      "protocol": { "type": "socks5", "settings": { "udp_relay": true, "handshake_timeout": "10s" } }
    },
    {
      "tag": "http-in",
      "listen": "127.0.0.1",
      "port": 1081,
      "network": "tcp",
      "transport": [{ "type": "tcp" }],
      "protocol": { "type": "http" }
    },
    {
      "tag": "mixed-in",
      "listen": "127.0.0.1",
      "port": 1082,
      "network": "tcp",
      "transport": [{ "type": "tcp" }],
      "protocol": {
        "type": "mixed",
        "settings": {
          "socks5": { "udp_relay": true },
          "http": {}
        }
      }
    }
  ],

  "routing": {
    "rules": [
      {
        "match": { "inbound": ["socks-in", "http-in", "mixed-in"], "network": "tcp" },
        "action": {
          "type": "sniff",
          "settings": { "sniffers": [{ "type": "tls" }, { "type": "http" }], "timeout": "300ms" }
        }
      },
      {
        "match": { "any": [{ "ip_is_private": true }, { "domain_suffix": ["ir"] }] },
        "action": { "type": "route", "settings": { "outbound": "freedom" } }
      },
      {
        "match": { "network": "udp", "port": [443] },
        "action": { "type": "block" }
      }
    ],
    "default_action": { "type": "route", "settings": { "outbound": "freedom-fragment" } }
  },

  "outbounds": [
    {
      "tag": "freedom",
      "protocol": { "type": "freedom" }
    },
    {
      "tag": "freedom-fragment",
      "transport": [
        { "type": "tcp" },
        {
          "type": "fragment",
          "settings": {
            "tls_records": true,
            "tcp_packets": true,
            "piece_sizes": ["3-5", "10-20"],
            "piece_delays": ["10-20ms"],
            "max_pieces": "4-8",
            "split_sni": true
          }
        }
      ],
      "protocol": { "type": "freedom" }
    }
  ]
}
